<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Best Wilco Song</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Current Songs</h1>
    <ul clas="songs">
        <% for(let i=0; i < info.length; i++) {%>
            <li class="song">
                <span><%= info[i].song %></span>
                <span><%= info[i].albumName %></span>
                <span><%= info[i].likes %></span>
                <i class="fa fa-thumbs-up"></i>
                <i class="fa fa-trash"></i>
            </li>
        <% } %>
    </ul>

    <h2>Add a Song</h2>
    <form action="/addSong" method="POST">
        <input type="text" placeholder="Song Name" name="songName">
        <input type="text" placeholder="Album Name" name="albumName">
        <input type="submit">
    </form>
    <script src="../js/main.js"></script>
</body>
</html>